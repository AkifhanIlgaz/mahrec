// Package alertdialog is vendored from workspace/heroui-go
// (components/alert_dialog/alert_dialog.templ), trimmed to what this
// project uses (no separate icon-custom / backdrop-variant helpers beyond
// what Reset/Delete confirmations need).
package alertdialog

import (
	"context"

	"mahrec/internal/web/ui/closebutton"
	"mahrec/internal/web/ui/icons"
	"mahrec/internal/web/ui/utils"
)

type alertDialogCtxKey int

const alertDialogContainerKey alertDialogCtxKey = 0

type Status string

const (
	StatusDefault Status = "default"
	StatusAccent  Status = "accent"
	StatusSuccess Status = "success"
	StatusWarning Status = "warning"
	StatusDanger  Status = "danger"
)

func (s Status) String() string {
	if s == "" {
		return string(StatusDefault)
	}
	return string(s)
}

type Size string

const (
	SizeXs    Size = "xs"
	SizeSm    Size = "sm"
	SizeMd    Size = "md"
	SizeLg    Size = "lg"
	SizeCover Size = "cover"
)

func (s Size) String() string {
	if s == "" {
		return string(SizeMd)
	}
	return string(s)
}

type Placement string

const (
	PlacementAuto   Placement = "auto"
	PlacementTop    Placement = "top"
	PlacementCenter Placement = "center"
	PlacementBottom Placement = "bottom"
)

func (p Placement) String() string {
	if p == "" {
		return string(PlacementAuto)
	}
	return string(p)
}

type BackdropVariant string

const (
	BackdropOpaque      BackdropVariant = "opaque"
	BackdropBlur        BackdropVariant = "blur"
	BackdropTransparent BackdropVariant = "transparent"
)

func (v BackdropVariant) String() string {
	if v == "" {
		return string(BackdropOpaque)
	}
	return string(v)
}

templ AlertDialog(tw ...string) {
	<div class={ templ.SafeClass(utils.Cn("contents", tw)) } data-slot="alert-dialog-root">
		{ children... }
	</div>
}

type BackdropProps struct {
	Variant                   BackdropVariant
	IsDismissable             bool
	IsKeyboardDismissDisabled bool
	Attrs                     templ.Attributes
}

templ AlertDialogBackdrop(p BackdropProps, tw ...string) {
	<div
		class={ utils.Cn(
			"alert-dialog__backdrop",
			"alert-dialog__backdrop--"+p.Variant.String(),
			tw,
		) }
		data-slot="alert-dialog-backdrop"
		hidden
		data-dismissable={ utils.BoolStr(p.IsDismissable) }
		data-keyboard-dismiss-disabled={ utils.BoolStr(p.IsKeyboardDismissDisabled) }
		{ p.Attrs... }
	>
		{ children... }
	</div>
}

type ContainerProps struct {
	Placement Placement // default: auto
	Size      Size      // default: md
	Attrs     templ.Attributes
}

templ AlertDialogContainer(p ContainerProps, tw ...string) {
	{{ ctx = context.WithValue(ctx, alertDialogContainerKey, p) }}
	<div
		class={ utils.Cn("alert-dialog__container", tw) }
		data-slot="alert-dialog-container"
		data-placement={ p.Placement.String() }
		{ p.Attrs... }
	>
		{ children... }
	</div>
}

func alertDialogContainer(ctx context.Context) ContainerProps {
	if p, ok := ctx.Value(alertDialogContainerKey).(ContainerProps); ok {
		return p
	}
	return ContainerProps{Placement: PlacementAuto, Size: SizeMd}
}

templ AlertDialogDialog(tw ...string) {
	{{ container := alertDialogContainer(ctx) }}
	<section
		class={ utils.Cn(
			"alert-dialog__dialog",
			"alert-dialog__dialog--"+container.Size.String(),
			tw,
		) }
		data-slot="alert-dialog-dialog"
		data-placement={ container.Placement.String() }
		role="alertdialog"
		aria-modal="true"
		tabindex="-1"
	>
		{ children... }
	</section>
}

templ AlertDialogHeader(tw ...string) {
	<div class={ utils.Cn("alert-dialog__header", tw) } data-slot="alert-dialog-header">
		{ children... }
	</div>
}

templ AlertDialogHeading(tw ...string) {
	<h2 class={ utils.Cn("alert-dialog__heading", tw) } data-slot="alert-dialog-heading" slot="title">
		{ children... }
	</h2>
}

templ AlertDialogBody(tw ...string) {
	<div class={ utils.Cn("alert-dialog__body", tw) } data-slot="alert-dialog-body">
		{ children... }
	</div>
}

templ AlertDialogFooter(tw ...string) {
	<div class={ utils.Cn("alert-dialog__footer", tw) } data-slot="alert-dialog-footer">
		{ children... }
	</div>
}

type IconProps struct {
	Status Status // default: danger
	Attrs  templ.Attributes
}

templ AlertDialogIcon(p IconProps, tw ...string) {
	<div
		class={ utils.Cn(
			"alert-dialog__icon",
			"alert-dialog__icon--"+p.Status.String(),
			tw,
		) }
		data-slot="alert-dialog-icon"
		{ p.Attrs... }
	>
		@icons.Status("alert-dialog-default-icon", p.Status.String())
	</div>
}

// React'te bu parça CloseButton'ı sarar; slot="close" alert_dialog.js'in
// kapatma delegasyonu tarafından yakalanır.
templ AlertDialogCloseTrigger(tw ...string) {
	@closebutton.CloseButton(closebutton.Props{Attrs: templ.Attributes{
		"data-slot": "alert-dialog-close-trigger",
		"slot":      "close",
	}}, utils.Cn("alert-dialog__close-trigger", tw))
}

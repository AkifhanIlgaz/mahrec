package components

import (
	"fmt"

	"mahrec/internal/models"
	"mahrec/internal/web/ui/alertdialog"
	"mahrec/internal/web/ui/button"
	"mahrec/internal/web/ui/card"
	"mahrec/internal/web/ui/icons"
	"mahrec/internal/web/ui/progressbar"
	"mahrec/internal/web/ui/textfield"
)

// confirmDialog renders the backdrop/dialog markup shared by the delete and
// reset confirmations; the caller supplies the confirm button's own action
// attributes (hx-post/hx-delete + target/swap) via confirmAttrs.
templ confirmDialog(heading, body, confirmLabel string, confirmAttrs templ.Attributes) {
	@alertdialog.AlertDialogBackdrop(alertdialog.BackdropProps{Variant: alertdialog.BackdropBlur, IsDismissable: true}) {
		@alertdialog.AlertDialogContainer(alertdialog.ContainerProps{}) {
			@alertdialog.AlertDialogDialog("sm:max-w-[360px]") {
				@alertdialog.AlertDialogCloseTrigger()
				@alertdialog.AlertDialogHeader() {
					@alertdialog.AlertDialogIcon(alertdialog.IconProps{Status: alertdialog.StatusDanger})
					@alertdialog.AlertDialogHeading() {
						{ heading }
					}
				}
				@alertdialog.AlertDialogBody() {
					<p>{ body }</p>
				}
				@alertdialog.AlertDialogFooter() {
					@button.Button(button.Props{Variant: button.VariantTertiary, Size: button.SizeSm, Attrs: templ.Attributes{"slot": "close"}}) {
						Vazgeç
					}
					@button.Button(button.Props{Variant: button.VariantDanger, Size: button.SizeSm, Attrs: confirmAttrs}) {
						{ confirmLabel }
					}
				}
			}
		}
	}
}

// ReadingContent renders a preset's reading (models.Reading) — an image
// scan, a multi-step phrase sequence, or plain Arabic/Turkish text — the
// same body used by the "Okunuş" dialog and the fullscreen tally screen.
templ ReadingContent(title string, reading models.Reading, hasReading bool) {
	if !hasReading || reading.IsEmpty() {
		<p class="text-muted">Bu okunuş metni henüz eklenmedi.</p>
	} else if reading.ImagePath != "" {
		<div data-slot="zoomable-image" class="overflow-hidden rounded-lg border border-separator touch-none select-none">
			<img src={ reading.ImagePath } alt={ "\"" + title + "\" okunuşu" } class="w-full origin-center"/>
		</div>
	} else if len(reading.Steps) > 0 {
		<div class="flex flex-col gap-5">
			for i, step := range reading.Steps {
				<div class="flex flex-col gap-2">
					<div class="flex items-center gap-2">
						<span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-accent px-1.5 text-[11px] font-bold text-accent-foreground">
							{ fmt.Sprintf("%d", i+1) }
						</span>
						<span class="text-xs font-medium text-muted">{ fmt.Sprintf("%d defa", step.Repeat) }</span>
					</div>
					if step.Arabic != "" {
						<p dir="rtl" class="whitespace-pre-line text-2xl leading-[2.6]" style="font-family: 'Amiri', serif;">{ step.Arabic }</p>
					}
					if step.Turkish != "" {
						<p class="whitespace-pre-line text-sm text-muted">{ step.Turkish }</p>
					}
				</div>
			}
			if reading.Note != "" {
				<p class="rounded-lg bg-surface-secondary p-3 text-xs text-muted">{ reading.Note }</p>
			}
		</div>
	} else {
		<div class="flex flex-col gap-4">
			if reading.Arabic != "" {
				<p dir="rtl" class="text-2xl leading-[2.6]" style="font-family: 'Amiri', serif;">{ reading.Arabic }</p>
			}
			if reading.Turkish != "" {
				<p class="text-sm text-muted">{ reading.Turkish }</p>
			}
		</div>
	}
}

// readingDialog shows a preset's Arabic text and Turkish transliteration
// (models.Reading). Unlike confirmDialog, it has no destructive action —
// just a close button.
templ readingDialog(title string, reading models.Reading, hasReading bool) {
	@alertdialog.AlertDialogBackdrop(alertdialog.BackdropProps{Variant: alertdialog.BackdropBlur, IsDismissable: true}) {
		@alertdialog.AlertDialogContainer(alertdialog.ContainerProps{}) {
			@alertdialog.AlertDialogDialog("sm:max-w-[400px]") {
				@alertdialog.AlertDialogCloseTrigger()
				@alertdialog.AlertDialogHeader() {
					@alertdialog.AlertDialogIcon(alertdialog.IconProps{Status: alertdialog.StatusAccent})
					@alertdialog.AlertDialogHeading() {
						{ title }
					}
				}
				@alertdialog.AlertDialogBody() {
					@ReadingContent(title, reading, hasReading)
				}
				@alertdialog.AlertDialogFooter() {
					@button.Button(button.Props{Variant: button.VariantTertiary, Size: button.SizeSm, Attrs: templ.Attributes{"slot": "close"}}) {
						Kapat
					}
				}
			}
		}
	}
}

// GoalItem's layout follows the "2a — centered vertical" card from the
// İstiğfar Kartı design (claude.ai/design), reskinned with this app's own
// theme tokens instead of the mockup's hardcoded colors: centered title +
// description, a large count, a thin progress bar, an amount+add row, and a
// bottom Okunuş/Sil/Sıfırla row. The underlying add/reset/delete logic is
// unchanged from before — no decrement was added.
templ GoalItem(g models.Goal) {
	{{ id := fmt.Sprintf("goal-%d", g.ID) }}
	{{ countColor := "text-accent" }}
	{{ if g.IsCompleted() {
		countColor = "text-success"
	} }}
	{{ reading, hasReading := models.ReadingFor(g.Title) }}
	@card.Card(card.Props{Variant: card.VariantSecondary, Attrs: templ.Attributes{"id": id}}, "rounded-[22px] border-0 shadow-md p-6") {
		@card.Content("flex flex-col items-center gap-0 text-center") {
			<span class="text-base font-bold">{ g.Title }</span>
			if g.Description != "" {
				<p class="m-0 mt-1.5 text-xs leading-relaxed text-muted">{ g.Description }</p>
			}

			<span data-slot="goal-count" class={ "mt-5 text-6xl leading-none font-extrabold tabular-nums", countColor }>
				{ fmt.Sprintf("%d", g.CurrentCount) }
			</span>
			<span class="mt-1 text-xs text-muted">{ fmt.Sprintf("/ %d", g.TargetCount) }</span>

			<div class="mt-4 w-full">
				if g.IsCompleted() {
					@progressbar.ProgressBar(progressbar.Props{Value: float64(g.CurrentCount), MaxValue: float64(g.TargetCount), Color: progressbar.ColorSuccess, Size: progressbar.SizeSm}) {
						@progressbar.Track() {
							@progressbar.Fill("transition-[width] duration-500 ease-out")
						}
					}
				} else {
					@progressbar.ProgressBar(progressbar.Props{Value: float64(g.CurrentCount), MaxValue: float64(g.TargetCount), Color: progressbar.ColorAccent, Size: progressbar.SizeSm}) {
						@progressbar.Track() {
							@progressbar.Fill("transition-[width] duration-500 ease-out")
						}
					}
				}
			</div>
			if g.IsCompleted() {
				<span class="mt-2 inline-flex items-center gap-1 rounded-full bg-success/10 px-2.5 py-1 text-[11px] font-semibold text-success [&>svg]:size-3.5">
					@icons.Status("goal-completed-icon", "success")
					Tamamlandı
				</span>
			}

			<div class="mt-5 flex items-center gap-1.5">
				@textfield.Input(textfield.InputProps{Type: "number", Name: "amount", Value: "1", IsDisabled: g.IsCompleted(), Attrs: templ.Attributes{"min": "1", "id": fmt.Sprintf("amount-%d", g.ID)}}, "w-14 text-center text-sm py-2 px-1")
				@button.Button(button.Props{
					Variant:    button.VariantPrimary,
					Size:       button.SizeSm,
					IsDisabled: g.IsCompleted(),
					Attrs: templ.Attributes{
						"aria-label": "Ekle",
						"hx-post":    fmt.Sprintf("/goals/%d/increment", g.ID),
						"hx-target":  "#" + id,
						"hx-swap":    "morph:outerHTML",
						"hx-include": fmt.Sprintf("#amount-%d", g.ID),
					},
				}, "text-lg font-bold leading-none") {
					+
				}
			</div>

			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d/tally", g.ID)) } class="button button--primary button--sm mt-3 w-full font-semibold">
				Tesbih Çek
			</a>

			<div class="mt-2 flex items-center gap-2">
				@alertdialog.AlertDialog() {
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}, "border-accent/40 text-accent") {
						Okunuş
					}
					@readingDialog(g.Title, reading, hasReading)
				}
				@alertdialog.AlertDialog() {
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}, "border-danger/40 text-danger") {
						Sil
					}
					@confirmDialog(
						"Hedefi silmek istediğine emin misin?",
						fmt.Sprintf("\"%s\" hedefi ve ilerlemesi kalıcı olarak silinecek. Bu işlem geri alınamaz.", g.Title),
						"Sil",
						templ.Attributes{
							"hx-delete": fmt.Sprintf("/goals/%d", g.ID),
							"hx-target": "closest li",
							"hx-swap":   "outerHTML swap:0.2s",
						},
					)
				}
				@alertdialog.AlertDialog() {
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
						Sıfırla
					}
					@confirmDialog(
						"Bu hedefi sıfırlamak istediğine emin misin?",
						fmt.Sprintf("\"%s\" hedefindeki ilerleme (%d / %d) sıfırlanacak.", g.Title, g.CurrentCount, g.TargetCount),
						"Sıfırla",
						templ.Attributes{
							"hx-post":   fmt.Sprintf("/goals/%d/reset", g.ID),
							"hx-target": "#" + id,
							"hx-swap":   "morph:outerHTML",
						},
					)
				}
			</div>
		}
	}
}

// GoalListItem wraps a single GoalItem in the <li> the list expects, so a
// goal appended via htmx (afterbegin into #goal-list) ends up with the same
// markup as one rendered as part of the initial list.
templ GoalListItem(g models.Goal) {
	<li>
		@GoalItem(g)
	</li>
}

templ GoalList(goals []models.Goal) {
	<ul id="goal-list" class="m-0 flex flex-col gap-3 list-none p-0">
		for _, g := range goals {
			@GoalListItem(g)
		}
	</ul>
}

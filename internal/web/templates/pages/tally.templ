package pages

import (
	"fmt"

	"mahrec/internal/models"
	"mahrec/internal/web/templates/components"
	"mahrec/internal/web/templates/layout"
	"mahrec/internal/web/ui/icons"
)

// Tally is the fullscreen "tesbih çekme" screen: the reading to recite,
// centered above a live circular-progress counter. Tapping the ring taps
// off a +1. Taps are batched — debounced ~700ms of idle, or flushed
// immediately when the screen is closed/backgrounded — into a single
// Increment request for this same goal (the one the user opened the
// screen from — no picker, since they already knew what they were
// reading), rather than one request per tap. There's nothing ever left
// meaningfully unsaved (the debounce window is short and flushed on
// every way of leaving the screen), so the back button is a plain "go
// home" link.
templ tallyCompletedBadge() {
	<span data-slot="tally-completed-badge" class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2.5 py-1 text-[11px] font-semibold text-success [&>svg]:size-3.5">
		@icons.Status("tally-completed-icon", "success")
		Tamamlandı
	</span>
}

templ Tally(goal models.Goal, reading models.Reading, hasReading bool) {
	@layout.Base(goal.Title + " · Tesbih") {
		<div
			data-slot="tally-screen"
			data-goal-id={ fmt.Sprintf("%d", goal.ID) }
			data-remaining={ fmt.Sprintf("%d", goal.TargetCount-goal.CurrentCount) }
			data-current={ fmt.Sprintf("%d", goal.CurrentCount) }
			data-target={ fmt.Sprintf("%d", goal.TargetCount) }
			class="fixed inset-0 z-40 flex flex-col bg-background"
		>
			<div class="flex items-center gap-3 p-4">
				<a href="/" id="tally-close" aria-label="Geri" class="button button--outline button--sm button--icon-only shrink-0">
					@icons.ArrowLeft("size-4")
				</a>
				<h1 class="text-lg font-bold">{ goal.Title }</h1>
			</div>
			if hasReading && !reading.IsEmpty() && reading.ImagePath != "" {
				<div class="flex min-h-0 flex-1 flex-col items-center gap-3 px-4 pb-4">
					if goal.IsCompleted() {
						@tallyCompletedBadge()
					}
					<div class="flex min-h-0 w-full max-w-xl flex-1 items-center justify-center [&_[data-slot=zoomable-image]]:flex [&_[data-slot=zoomable-image]]:h-full [&_[data-slot=zoomable-image]]:w-full [&_[data-slot=zoomable-image]]:items-center [&_[data-slot=zoomable-image]]:justify-center [&_[data-slot=zoomable-image]_img]:h-full [&_[data-slot=zoomable-image]_img]:w-auto [&_[data-slot=zoomable-image]_img]:max-w-full [&_[data-slot=zoomable-image]_img]:object-contain">
						@components.ReadingContent(goal.Title, reading, hasReading)
					</div>
				</div>
			} else {
				<div class="flex flex-1 flex-col items-center overflow-y-auto px-6 pb-6">
					<div class="m-auto flex w-full max-w-xl flex-col items-center gap-4 text-center">
						if goal.IsCompleted() {
							@tallyCompletedBadge()
						}
						@components.ReadingContent(goal.Title, reading, hasReading)
					</div>
				</div>
			}
			<div class="border-t border-separator p-6">
				<div class="mx-auto flex w-full max-w-xl flex-col items-center gap-3">
					<span
						id="tally-count"
						data-slot="tally-count"
						class={ "text-4xl leading-none font-extrabold tabular-nums", templ.KV("text-success", goal.IsCompleted()), templ.KV("text-accent", !goal.IsCompleted()) }
					>
						{ fmt.Sprintf("%d", goal.CurrentCount) }
					</span>
					<button
						type="button"
						id="tally-increment"
						aria-label="Bir okuma ekle"
						disabled?={ goal.IsCompleted() }
						class="relative flex size-28 shrink-0 items-center justify-center rounded-full"
					>
						<svg viewBox="0 0 120 120" class="size-28 -rotate-90">
							<circle cx="60" cy="60" r="54" stroke-width="6" fill="none" class="stroke-separator"></circle>
							<circle
								id="tally-ring-progress"
								cx="60"
								cy="60"
								r="54"
								stroke-width="6"
								stroke-linecap="round"
								fill="none"
								class={ "transition-[stroke-dashoffset] duration-200 ease-out", templ.KV("stroke-success", goal.IsCompleted()), templ.KV("stroke-accent", !goal.IsCompleted()) }
							></circle>
						</svg>
						<span
							id="tally-ring-check"
							class={ "absolute inset-0 items-center justify-center text-success [&>svg]:size-9", templ.KV("flex", goal.IsCompleted()), templ.KV("hidden", !goal.IsCompleted()) }
						>
							@icons.Check("size-9")
						</span>
					</button>
					<p id="tally-hint" class={ "text-xs text-muted", templ.KV("hidden", goal.IsCompleted()) }>
						Artırmak için halkaya dokun
					</p>
				</div>
			</div>
		</div>
		<script>
			(function () {
				var DEBOUNCE_MS = 1000;
				var CIRCUMFERENCE = 2 * Math.PI * 54;

				var taps = 0;
				var pending = 0; // tapped but not yet sent to the server
				var debounceTimer = null;
				var screen = document.querySelector('[data-slot="tally-screen"]');
				var goalId = screen.getAttribute("data-goal-id");
				var remaining = parseInt(screen.getAttribute("data-remaining"), 10) || 0;
				var total = parseInt(screen.getAttribute("data-current"), 10) || 0;
				var target = parseInt(screen.getAttribute("data-target"), 10) || 0;
				var countEl = document.querySelector('[data-slot="tally-count"]');
				var incrementBtn = document.getElementById("tally-increment");
				var progressRing = document.getElementById("tally-ring-progress");
				var checkEl = document.getElementById("tally-ring-check");
				var hintEl = document.getElementById("tally-hint");

				progressRing.style.strokeDasharray = CIRCUMFERENCE;

				function renderProgress() {
					var pct = target > 0 ? Math.min(total / target, 1) : 0;
					progressRing.style.strokeDashoffset = CIRCUMFERENCE * (1 - pct);
				}

				function markCompleted() {
					incrementBtn.disabled = true;
					countEl.classList.remove("text-accent");
					countEl.classList.add("text-success");
					progressRing.classList.remove("stroke-accent");
					progressRing.classList.add("stroke-success");
					checkEl.classList.remove("hidden");
					checkEl.classList.add("flex");
					hintEl.classList.add("hidden");
				}

				renderProgress();
				if (remaining <= 0) markCompleted();

				function flush() {
					if (pending <= 0) return;
					var amount = pending;
					pending = 0;
					clearTimeout(debounceTimer);

					var body = "amount=" + amount;
					if (navigator.sendBeacon) {
						navigator.sendBeacon(
							"/goals/" + goalId + "/increment",
							new Blob([body], { type: "application/x-www-form-urlencoded" })
						);
						return;
					}
					// Best-effort fallback: a dropped request under-counts the goal
					// by the batch that was in flight. Rare on a local/self-hosted
					// setup, and re-tapping is the natural recovery, so no retry
					// machinery beyond this.
					fetch("/goals/" + goalId + "/increment", {
						method: "POST",
						headers: { "Content-Type": "application/x-www-form-urlencoded" },
						body: body,
						keepalive: true,
					}).catch(function () {});
				}

				incrementBtn.addEventListener("click", function () {
					taps++;

					total++;
					countEl.textContent = total;
					renderProgress();

					if (taps >= remaining) {
						markCompleted();
						if (navigator.vibrate) navigator.vibrate([15, 60, 15, 60, 30]);
					} else if (navigator.vibrate) {
						navigator.vibrate(10);
					}

					pending++;
					clearTimeout(debounceTimer);
					debounceTimer = setTimeout(flush, DEBOUNCE_MS);
				});

				document.getElementById("tally-close").addEventListener("click", flush);
				document.addEventListener("visibilitychange", function () {
					if (document.visibilityState === "hidden") flush();
				});
				window.addEventListener("pagehide", flush);
			})();
		</script>
	}
}
